<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>학생용 플래시카드</title>

<style>
body { 
    display:flex; 
    flex-direction:column; 
    align-items:center; 
    justify-content:center; 
    height:100vh; 
    margin:0; 
    background:#f0f2f5; 
    font-family:sans-serif; 
}
.card { 
    width:90%; 
    max-width:400px; 
    height:500px; 
    background:white; 
    border-radius:20px; 
    box-shadow:0 10px 20px rgba(0,0,0,0.1); 
    display:flex; 
    flex-direction:column; 
    align-items:center; 
    justify-content:center; 
    cursor:pointer; 
    transition:transform .2s; 
    text-align:center; 
    padding:20px; 
    box-sizing:border-box; 
}
.card:active { transform:scale(.98); }
img { 
    max-width:100%; 
    max-height:70%; 
    border-radius:10px; 
    margin-bottom:20px; 
    pointer-events:none; 
}
.text { 
    font-size:2rem; 
    font-weight:bold; 
    color:#333; 
    min-height:3rem; 
}
.hint { 
    color:#888; 
    margin-top:20px; 
    font-size:.9rem; 
}
.progress { 
    margin-bottom:10px; 
    color:#555; 
}
button { 
    margin-bottom:20px; 
    font-size:1rem; 
    padding:5px 10px; 
}
</style>
</head>

<body>

<button onclick="goMenu()">メニューに戻る</button>

<div class="progress" id="progress">1 / 0</div>

<div class="card" onclick="nextCard()">
    <img id="card-img" src="">
    <div class="text" id="card-text"></div>
    <div class="hint">(画面をクリックすると次のカードに進みます。)</div>
</div>

<script>

const flashcards = [
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-1.png", text:"1시56분", audio:"w-1.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-2.png", text:"2시55분", audio:"w-2.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-3.png", text:"3시35분", audio:"w-3.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-4.png", text:"4시5분", audio:"w-4.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-5.png", text:"5시36분", audio:"w-5.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-6.png", text:"6시49분", audio:"w-6.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-7.png", text:"7시30분", audio:"w-7.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-8.png", text:"8시25분", audio:"w-8.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-9.png", text:"9시40분", audio:"w-9.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-10.png", text:"10시10분", audio:"w-10.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-11.png", text:"11시13분", audio:"w-11.mp3" },
    { img:"https://raw.githubusercontent.com/wakuseiboy-prog/korean/main/w-12.png", text:"12시18분", audio:"w-12.mp3" }
];

let shuffled = [];
let currentIndex = 0;
let step = 0; // 0=이미지, 1=문자, 2=음성

// Audio 객체
const player = new Audio();
player.preload = "auto";

// 카드 순서를 랜덤으로 섞기
function shuffleCards() {
    shuffled = [...flashcards];

    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    currentIndex = 0;
}

// 이미지 표시
function showQuestion() {
    const card = shuffled[currentIndex];

    document.getElementById("card-img").src = card.img;
    document.getElementById("card-text").innerText = "";
    document.getElementById("progress").innerText =
        `${currentIndex + 1} / ${shuffled.length}`;

    step = 0;

    if (card.audio) {
        player.src = card.audio;
    }
}

// 문자 표시
function showText() {
    const card = shuffled[currentIndex];
    document.getElementById("card-text").innerText = card.text;
}

// 음성 재생
function playAudio() {
    const card = shuffled[currentIndex];

    if (!card.audio) return;

    player.currentTime = 0;
    player.play();
}

// 클릭 시 단계 진행
function nextCard() {

    if (step === 0) {

        showText();
        step = 1;

    } else if (step === 1) {

        playAudio();
        step = 2;

    } else {

        currentIndex++;

        // 마지막 카드까지 보면 다시 랜덤으로 섞음
        if (currentIndex >= shuffled.length) {
            shuffleCards();
        }

        showQuestion();
    }
}

function goMenu() {
    window.location.href = "index.html";
}

window.onload = () => {
    shuffleCards();
    showQuestion();
};

</script>

</body>
</html>
